# ============================================================
#  ASOX Market Telegram Bot — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ============================================================

# --- MAJBURIY ---

# Asosiy foydalanuvchi boti tokeni (@BotFather)
BOT_TOKEN=7890123456:AAExampleTokenHere_ReplaceWithYourOwn

# Adminlarning raqamli Telegram ID lari, vergul bilan.
# ID ni @userinfobot dan oling. Username bo'yicha admin aniqlash
# QO'LLAB-QUVVATLANMAYDI (username bo'shatilib boshqa odam olishi mumkin).
ADMIN_IDS=123456789,987654321

# `/start shop_<id>_<imzo>` do'kon ulash havolalarini imzolash kaliti.
# asox.uz backendidagi qiymat bilan BIR XIL bo'lishi shart, aks holda
# do'kon ulash butunlay o'chadi (fail-closed).
# Yaratish:  python3 -c "import secrets; print(secrets.token_hex(32))"
SHOP_LINK_SECRET=

# --- ADMIN BOT (ixtiyoriy) ---
# Alohida @asox_admin_bot tokeni. Bo'sh bo'lsa admin bot ishga tushmaydi.
ADMIN_BOT_TOKEN=

# --- FIRESTORE (ixtiyoriy, lekin production uchun zarur) ---
# Bittasini tanlang. Ikkalasi ham bo'sh bo'lsa bot xotiradagi namuna
# ma'lumotlar bilan ishlaydi va restartda hammasi yo'qoladi.
#
# 1) Lokal ishlab chiqish — service account fayli yo'li:
FIREBASE_SERVICE_ACCOUNT=
# 2) Render / Railway — JSON ni to'liq matn sifatida (bitta qatorda):
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- QO'SHIMCHA ---

# Health-check HTTP serveri porti (lokal test va Docker uchun)
PORT=8080

# Muhit: development / production
ENVIRONMENT=development
