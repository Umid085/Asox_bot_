# Telegram Bot Token (from @BotFather)
BOT_TOKEN=7890123456:AAExampleTokenHere_ReplaceWithYourOwn

# Admin Telegram IDs (comma-separated integers)
ADMIN_IDS=123456789,987654321

# Webhook configuration (Optional for Render / Railway webhook mode)
# If left empty, bot will automatically run in Long Polling mode.
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/webhook
PORT=8080

# Environment: development / production
ENVIRONMENT=development

# Do'kon ulash havolalarini imzolash kaliti (asox.uz backendi bilan bir xil bo'lishi shart)
# Yaratish: python3 -c "import secrets; print(secrets.token_hex(32))"
SHOP_LINK_SECRET=
